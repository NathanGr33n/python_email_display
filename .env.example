# Email Summarizer - IMAP Configuration
# WARNING: Using .env for credentials is less secure than keyring storage
# Only use this if keyring is not available on your system

# IMAP server settings
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=your.email@gmail.com
IMAP_PASSWORD=your_app_password_here

# For Gmail: Enable 2FA and generate an App Password
# For other providers: Check their IMAP settings documentation